# إعدادات النظام وتيليجرام (نسخة جاهزة للنشر - املأ بياناتك في ملف .env الحقيقي)
ADMIN_TOKEN=change_me_strong_secret_token
ENABLE_LLM=true

# مزود الذكاء الاصطناعي: ollama (محلي مجاني - افتراضي) | gemini | openai | auto
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=lfm2.5:latest
# اختياري: موديل أقوى محلياً عند التوجيه للحالات المعقدة (اتركه فارغاً لتفادي تبديل الـ VRAM)
OLLAMA_PRO_MODEL=

# مزود Google Gemini (اختياري — يدعم Model Routing + Explicit Context Caching)
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# مزود OpenAI أو أي مزود متوافق (OpenRouter / Groq / DeepSeek)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_PRO_MODEL=gpt-4o

# التوجيه الذكي والكاش المخبأ (المحطة 3)
ENABLE_MODEL_ROUTING=true
ENABLE_CONTEXT_CACHE=true
CONTEXT_CACHE_TTL_SECONDS=1800
CONTEXT_CACHE_MIN_CHARS=4000

# المُحكّم الآلي الخلفي (المحطة 8 — اختياري: مزود/موديل مستقل للتدقيق)
ENABLE_JUDGE=true
JUDGE_PROVIDER=
JUDGE_MODEL=

# الذاكرة المهيكلة للعملاء + بوابة الإجراءات JSON Webhook (المحطة 2 و 5)
ENABLE_MEMORY_FACTS=true
ENABLE_ACTION_EXTRACTOR=true
ACTION_WEBHOOK_URL=
ACTION_WEBHOOK_SECRET=

TENANT_ID=default

# اسم المتجر/الشركة والعملة الافتراضية في ردود البوت
STORE_NAME=مطبعة الأصيل للطباعة والتغليف
STORE_CURRENCY=الجنيه المصري

# حدود الحماية من الإغراق وتزامن الذكاء الاصطناعي
RATE_LIMIT_PER_MINUTE=30
LLM_MAX_CONCURRENCY=3
ENABLE_RERANKER=false

# توكن تيليجرام الرسمي (احصل عليه من @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=
